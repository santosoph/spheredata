lawsheCVR <- function(data){
cutoff <- max(data)/2
N <-  nrow(data)
n_e <- apply(data,2,function(row) sum(row > cutoff))
cvr <- (2*n_e/N) - 1
return(data.frame("CVR" = cvr))
}
lawsheCVR(df)
lawsheCVR <- function(data, method = "max"){
if(method == "max"){
cutoff <- max(data)/2
}
N <-  nrow(data)
n_e <- apply(data,2,function(row) sum(row > cutoff))
cvr <- (2*n_e/N) - 1
return(data.frame("CVR" = cvr))
}
lawsheCVR(df)
lawsheCVR <- function(data, method = "max"){
if(method == "max"){
cutoff <- max(data)/2
} else(method == "min"){
lawsheCVR <- function(data, method = "max"){
if (method == "max"){
cutoff <- max(data)/2
} elseif (method == "min"){
if (method == "max"){
cutoff <- max(data)/2
} else if(method == "min"){
cutoff <- min(data)
}
lawsheCVR <- function(data, method = "max"){
if (method == "max"){
cutoff <- max(data)/2
} else if(method == "min"){
cutoff <- min(data)
}
N <-  nrow(data)
n_e <- apply(data,2,function(row) sum(row > cutoff))
cvr <- (2*n_e/N) - 1
return(data.frame("CVR" = cvr))
}
lawsheCVR(df)
lawsheCVR(df, method = "min")
