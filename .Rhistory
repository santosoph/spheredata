lawsheCVR <- function(data, max_cat, min_cat){
cutoff <- (max_cat - min_cat)/2
N <-  nrow(data)
n_e <- apply(data,1,function(row) sum(row > cutoff))
cvr <- (2*n_e/N) - 1
return(cvr)
lawsheCVR <- function(data, max_cat, min_cat){
cutoff <- (max_cat - min_cat)/2
N <-  nrow(data)
n_e <- apply(data,1,function(row) sum(row > cutoff))
cvr <- (2*n_e/N) - 1
return(cvr)
}
